<div class="auth-card">
  <h1>Forgot your password?</h1>

  <%= render "layouts/flash" %>

  <%= form_with url: passwords_path do |form| %>
    <div>
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.org", value: params[:email_address] %>
    </div>

    <div>
      <%= form.submit "Email reset instructions" %>
    </div>
  <% end %>
</div>
